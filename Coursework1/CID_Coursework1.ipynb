    "\n",
    "def cross_val_evaluate(data, num_folds, c_values=1, regul_strength_values=100):\n",
    "    \"\"\"\n",
    "    Performs T-fold cross-validation on the given dataset to find the optimal regul_strength.\n",
    "\n",
    "    Parameters:\n",
    "        data (np.array): The dataset, where the last column contains the target labels.\n",
    "        num_folds (int): The number of folds for cross-validation.\n",
    "        regul_strength_values (list): A list of regularisation strength values to evaluate.\n",
    "\n",
    "    Returns:\n",
    "        tuple: A tuple containing two lists:\n",
    "            - train_scores (list): Accuracy scores on the training set for each regul_strength.\n",
    "            - val_scores (list): Accuracy scores on the validation set for each regul_strength.\n",
    "    \"\"\"\n",
    "\n",
    "    mat_train = np.zeros((len(c_values), len(regul_strength_values)))\n",
    "    mat_validation = np.zeros((len(c_values), len(regul_strength_values)))\n",
    "\n",
    "    folds = cross_val_split(data.shape[0], num_folds) # Get indicies to split data\n",
    "    train_scores = np.zeros((len(c_values), len(regul_strength_values)))\n",
    "    validation_scores = np.zeros((len(c_values), len(regul_strength_values)))\n",
    "\n",
    "    for k, c in enumerate(c_values):\n",
    "        print(f'\\nEvaluating c_value: {c}')\n",
    "        for j, regularisation_strength in enumerate(regul_strength_values):\n",
    "            print(f'\\nEvaluating regul_strength: {regularisation_strength}')\n",
    "            for i, validation_indices in enumerate(folds):\n",
    "\n",
    "                # Define the training and validation sets\n",
    "                train_indices = np.setdiff1d(np.arange(data.shape[0]), validation_indices)\n",
    "                X_train, y_train = data[train_indices, :-1], data[train_indices, -1]\n",
    "                X_val, y_val = data[validation_indices, :-1], data[validation_indices, -1]\n",
    "\n",
    "                # We standardise both training and validation sets\n",
    "                X_train_std = standardise(X_train)\n",
    "                X_val_std = standardise(X_val, X_train)\n",
    "\n",
    "                # Add intercept term (bias) to the feature matrices\n",
    "                X_train = np.hstack((X_train_std, np.ones((len(X_train_std), 1))))\n",
    "                X_val = np.hstack((X_val_std, np.ones((len(X_val_std), 1))))\n",
    "\n",
    "                # Train the model using mini-batch stochastic gradient descent\n",
    "                    \n",
    "                weights, _, _ = mini_batch_gradient_descent_Huber(\n",
    "                    X_train, y_train, \n",
    "                    regul_strength=regularisation_strength\n",
    "                )\n",
    "\n",
    "                # Evaluate performance on validation set for the corresponding fold\n",
    "                mat_train[k,j] += score(weights, X_train, y_train) / num_folds\n",
    "                mat_validation[k,j] += score(weights, X_val, y_val) / num_folds\n",
    "            print(f'Training score: {mat_train[k,j]}')\n",
    "            print(f'Validation score: {mat_validation[k,j]}')\n",
    "\n",
    "\n",
    "    return mat_train, mat_validation\n",
    "\n"
   ]

    "def build_tree_rf(n_features, X, y, cat_columns_dict, feature_names, depth, number_of_total_samples, max_depth=10, min_samples_leaf=12):\n",
    "    \"\"\"构建决策树，并计算 Gini 重要性.\"\"\"\n",
    "    \n",
    "    number_of_samples = len(X)\n",
    "\n",
    "    p_t = number_of_samples/number_of_total_samples\n",
    "    \n",
    "    if len(np.unique(y)) == 1 or depth > max_depth or len(X) <= min_samples_leaf:\n",
    "        return {'majority_label': majority_vote(y),\n",
    "                'number_of_samples': number_of_samples,\n",
    "                'Gini_index': 0}\n",
    "    \n",
    "    GI, split_column, split_val = gini_split_rf(n_features, X, y, cat_columns_dict)\n",
    "    \n",
    "    if GI == np.inf:\n",
    "        return {'majority_label': majority_vote(y),\n",
    "                'number_of_samples': number_of_samples,\n",
    "                'Gini_index': 0}\n",
    "    \n",
    "    categorical = cat_columns_dict[split_column]\n",
    "    (X_l, y_l), (X_r, y_r) = split_samples(X, y, split_column, split_val, categorical)\n",
    "    \n",
    "    GI_t = gini_index(y)\n",
    "    GI_tL = gini_index(y_l) #if len(y_l) > 0 else 0\n",
    "    GI_tR = gini_index(y_r) #if len(y_r) > 0 else 0\n",
    "    \n",
    "    p_L = len(y_l) / number_of_samples #if len(y_l) > 0 else 0\n",
    "    p_R = len(y_r) / number_of_samples #if len(y_r) > 0 else 0\n",
    "    \n",
    "    delta_GI = GI_t - (p_L * GI_tL + p_R * GI_tR)\n",
    "\n",
    "    \n",
    "    if feature_names[split_column] in gini_importance_dict:\n",
    "        gini_importance_dict[feature_names[split_column]] += p_t * delta_GI\n",
    "    else:\n",
    "        gini_importance_dict[feature_names[split_column]] = p_t * delta_GI\n",
    "    \n",
    "    return {\n",
    "        'feature_name': feature_names[split_column],\n",
    "        'feature_index': split_column,\n",
    "        'value': split_val,\n",
    "        'categorical': categorical,\n",
    "        'majority_label': None,\n",
    "        'number_of_samples': number_of_samples,\n",
    "        'Gini_index': GI,\n",
    "        'left': build_tree_rf(n_features, X_l, y_l, cat_columns_dict, feature_names, depth + 1, number_of_total_samples, max_depth, min_samples_leaf),\n",
    "        'right': build_tree_rf(n_features, X_r, y_r, cat_columns_dict, feature_names, depth + 1, number_of_total_samples, max_depth, min_samples_leaf)\n",
    "    }\n"
   ]

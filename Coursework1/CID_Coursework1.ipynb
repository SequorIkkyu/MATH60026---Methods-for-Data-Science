    "import numpy as np\n",
    "\n",
    "N = len(X_train)\n",
    "B = [10]\n",
    "training_indices = np.arange(N)\n",
    "oob_errors = np.zeros(len(B))\n",
    "\n",
    "rng = np.random.default_rng() \n",
    "n_features = X_train.shape[1]\n",
    "max_depth = 10\n",
    "\n",
    "X = X_train\n",
    "y = y_train\n",
    "for j in range(len(B)):\n",
    "    trees = []\n",
    "    oob_predictions = {i: [] for i in range(N)}\n",
    "\n",
    "    for ind in range(B[j]):\n",
    "        sample = rng.choice(training_indices, N, replace=True)\n",
    "        sample = sorted(sample)\n",
    "        oob_samples_index = sorted(list(set(training_indices) - set(sample)))\n",
    "        oob_samples_X = np.take(X, oob_samples_index, axis=0)\n",
    "        oob_samples_y = np.take(y, oob_samples_index, axis=0)\n",
    "        X_sample = X_train[sample, :]\n",
    "        y_sample = y_train[sample]\n",
    "\n",
    "        tree = build_tree_rf(n_features, X_sample, y_sample, cat_columns_dict, feature_names, number_of_total_samples=X_train.shape[0],\n",
    "                             depth=1, max_depth=max_depth)\n",
    "        trees.append(tree)\n",
    "\n",
    "        prediction = predict_rf(trees, oob_samples_X)\n",
    "        oob_error = np.mean(prediction != oob_samples_y)\n",
    "\n",
    "        oob_errors[j] += oob_error\n",
    "\n",
    "    oob_errors[j] /= B[j]\n",
    "    print(f\"B = {B[j]}, Averaged OOB Error: {oob_errors[j]:.4f}\")\n",
    "\n",
    "optimal_B = B[np.argmin(oob_errors)]\n",
    "print(f\"Optimal B: {optimal_B}\")\n"
   ]

    "def compound_loss(T, T_pred, l=0):\n",
    "\n",
    "    assert T.size == T_pred.size, \"Error\"\n",
    "\n",
    "    T = T.reshape(T_pred.shape)\n",
    "\n",
    "    T_min, T_max = T[:,0], T[:,1]\n",
    "    T_min_pred, T_max_pred = T_pred[:,0], T_pred[:,1]\n",
    "\n",
    "    T_min = T_min.reshape(T_min_pred.shape)\n",
    "    T_max = T_max.reshape(T_max_pred.shape)\n",
    "\n",
    "    MSE_min = mse_loss(T_min, T_min_pred)\n",
    "    MSE_max = mse_loss(T_max, T_max_pred)\n",
    "\n",
    "    key = [T_min_pred > T_max_pred]\n",
    "    \n",
    "\n",
    "    return MSE_min + MSE_max + l*np.mean(key)\n",
    "\n",
    "\n",
    "def compound_grad(T, T_pred, l=0):\n",
    "    assert T.shape == T_pred.shape, \"Error: Shapes of T and T_pred must match!\"\n",
    "    \n",
    "    T_min, T_max = T[:, 0], T[:, 1]\n",
    "    T_min_pred, T_max_pred = T_pred[:, 0], T_pred[:, 1]\n",
    "\n",
    "    grad_min = (2.0 * (T_min - T_min_pred) / len(T_min)).reshape(-1, 1)\n",
    "    grad_max = (2.0 * (T_max - T_max_pred) / len(T_min)).reshape(-1, 1)\n",
    "\n",
    "    key = (T_min_pred > T_max_pred).astype(float).reshape(-1, 1)\n",
    "\n",
    "    grad_min += (l * key) / len(T_min)\n",
    "    grad_max -= (l * key) / len(T_min)\n",
    "\n",
    "    return np.hstack((grad_min, grad_max)) \n",
    "\n",
    "\n"
   ]
  },

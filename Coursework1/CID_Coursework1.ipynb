    "    distances = 1 - y * (X @ w)  ## <-- SOLUTION\n",
    "    distances[distances < 0] = 0  # equivalent to max(0, distance)\n",
    "    hinge = distances.sum() ## <-- SOLUTION\n",
    "\n",
    "    # calculate loss\n",
    "    return 0.5 * np.dot(w, w) + regul_strength * hinge - 0.5 * w[-1] ** 2\n",
